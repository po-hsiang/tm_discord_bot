# 複製此檔為 .env 並填入實際值（.env 不入版控；Docker 由 compose.yaml 的 env_file 注入）
# 非機敏設定（頻道 ID、歌單 ID）放 tm_discord_bot/config/config.ini

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token

# --- Google Sheets（吃什麼清單）---
GOOGLE_CREDENTIAL_FILE=your_service_account.json
WHAT_TO_EAT_URL=https://docs.google.com/spreadsheets/d/your_sheet_url

# --- yt-music-mcp 歌單微服務（bot 與其同在 ai-net docker 網路，用服務名直連；本機直跑改 http://127.0.0.1:8765）---
YT_MUSIC_API_URL=http://yt-music-mcp:8765

# --- n8n Discord AI Agent ---
# n8n 管理 API 金鑰（開發輔助用；bot 執行期不需要）
N8N_API_KEY=your_n8n_api_key
# bot 容器經 host.docker.internal 直連宿主機 n8n
N8N_AGENT_WEBHOOK_URL=http://host.docker.internal:5678/webhook/discord-ai-agent
# webhook Header Auth 共享密鑰（n8n 端 Webhook 節點須設定相同值，header 名稱 X-Webhook-Secret）
N8N_WEBHOOK_SECRET=your_webhook_shared_secret
# AI 回覆逾時秒數（選填，預設 60）
#N8N_AGENT_TIMEOUT=60

# --- n8n YouTube 影片快速摘要（與 AI Agent 共用 N8N_WEBHOOK_SECRET）---
N8N_YT_SUMMARY_WEBHOOK_URL=http://host.docker.internal:5678/webhook/yt-summary
# 摘要逾時秒數（選填，預設 200；逾時階梯：bot 200 > n8n 190 > yt-music-mcp 180）
#N8N_YT_SUMMARY_TIMEOUT=200
